# Copiar a .env.local y completar.
# Base de datos PostgreSQL (16 o superior).
DATABASE_URL=postgres://usuario:clave@localhost:5432/micaela_massa_odontologia

# Almacenamiento de adjuntos (S3 compatible con Object Lock en modo COMPLIANCE).
ADJUNTOS_BUCKET=
ADJUNTOS_REGION=

# Inicio de sesión (ver docs/arquitectura.md, "Inicio de sesión").
# Clave para cifrar en la base las claves de las apps de autenticación. Obligatoria
# en producción: al menos 32 caracteres al azar (por ejemplo: openssl rand -base64 48).
# Si se pierde, todos tienen que volver a configurar la verificación en dos pasos.
CLAVE_SECRETOS=
# Dirección pública del sistema (por ejemplo https://sistema.ejemplo.com.ar), para los enlaces de primer ingreso y blanqueo.
URL_PUBLICA=
# Opcional: horas sin uso hasta que se cierra la sesión (12) y días máximos que dura (7).
SESION_INACTIVIDAD_HORAS=
SESION_MAXIMA_DIAS=

# Opcional, solo para una demo online: pide esta contraseña (HTTP Basic) en todo el sitio.
DEMO_CLAVE=
