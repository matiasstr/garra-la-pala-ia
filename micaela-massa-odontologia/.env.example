# Copiar a .env.local y completar. Nunca compartas .env.local (tiene la clave de la base y CLAVE_SECRETOS).
# Base de datos PostgreSQL (16 o superior).
DATABASE_URL=postgres://usuario:clave@localhost:5432/micaela_massa_odontologia

# Almacenamiento de adjuntos (S3 compatible con Object Lock en modo COMPLIANCE).
ADJUNTOS_BUCKET=
ADJUNTOS_REGION=

# Inicio de sesión (ver docs/arquitectura.md, "Inicio de sesión").
# Clave para cifrar en la base las claves de las apps de autenticación. Obligatoria
# en producción: al menos 32 caracteres al azar (por ejemplo: openssl rand -base64 48).
# Si se pierde, todos tienen que volver a configurar la verificación en dos pasos.
CLAVE_SECRETOS=
# Dirección pública del sistema (por ejemplo https://sistema.ejemplo.com.ar), para los enlaces de primer ingreso y blanqueo.
URL_PUBLICA=
# Opcional: horas sin uso hasta que se cierra la sesión (12) y días máximos que dura (7).
SESION_INACTIVIDAD_HORAS=
SESION_MAXIMA_DIAS=

# Solo para la demo online con datos inventados (ver docs/demo.md). Nunca con pacientes reales,
# ni en el .env.local de la instalación real: la demo usa su propia base, que la semilla marca como de prueba.
# MODO_DESARROLLO=1          datos y usuarios de prueba; migra y siembra la base al conectar (solo una base vacía o de prueba)
# DEMO_PERMITE_REINICIO=1    botón "Reiniciar datos de prueba" (requiere también MODO_DESARROLLO=1)
# DEMO_CLAVE=                contraseña compartida (HTTP Basic) que pide el navegador para entrar a todo el sitio;
#                            obligatoria con MODO_DESARROLLO=1 en una versión compilada (npm start o Vercel)
# DATABASE_URL_UNPOOLED=     conexión directa para migrar (la carga la integración de Neon)
