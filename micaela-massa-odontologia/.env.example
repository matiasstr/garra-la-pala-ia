# Copiar a .env.local y completar.
# Base de datos PostgreSQL (16 o superior).
DATABASE_URL=postgres://usuario:clave@localhost:5432/micaela_massa_odontologia

# Almacenamiento de adjuntos (S3 compatible con Object Lock en modo COMPLIANCE).
ADJUNTOS_BUCKET=
ADJUNTOS_REGION=

# Solo para la demo online con datos inventados (ver docs/demo.md). Nunca con pacientes reales.
# MODO_DESARROLLO=1          datos y usuarios de prueba; migra y siembra la base al conectar
# DEMO_PERMITE_REINICIO=1    botón "Reiniciar datos de prueba" (requiere también MODO_DESARROLLO=1)
# DEMO_CLAVE=                contraseña compartida que pide el navegador para entrar
# DATABASE_URL_UNPOOLED=     conexión directa para migrar (la carga la integración de Neon)
