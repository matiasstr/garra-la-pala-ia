{
  "name": "garra-la-pala-ia",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @garra/extension",
    "dev": "npm run dev -w @garra/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p apps/extension",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
