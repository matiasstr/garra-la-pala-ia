{
  "manifest_version": 3,
  "name": "Garra la Pala IA",
  "short_name": "Garra",
  "version": "0.1.0",
  "description": "Completa postulaciones fuera de LinkedIn con tu CV: datos, adjunto y respuestas redactadas con Codex/ChatGPT o APIs gratis.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.linkedin.com/*", "*://linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Garra la Pala IA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
